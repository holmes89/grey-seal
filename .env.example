# Copy to .env (git-ignored) and fill in real values.
# `docker compose up` reads this automatically.

# Shared secret between the api service (as LITELLM_API_KEY) and the
# litellm service (as LITELLM_MASTER_KEY) — must be the same value on both
# sides. Generate one with: openssl rand -hex 32
LITELLM_API_KEY=
